{
  "name": "chrome-cool-copy",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension for enhanced copy functionality",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:extension": "pnpm -F @repo/extension build",
    "build:clips": "pnpm -F @repo/clips build",
    "build:chat": "pnpm -F @repo/chat build",
    "dev": "pnpm build:extension && pnpm watch:chat",
    "watch:chat": "pnpm -F @repo/chat watch",
    "watch:extension": "pnpm -F @repo/extension watch",
    "lint": "oxlint apps/*/src apps/*/app packages/*/src",
    "format": "oxfmt --write 'apps/**/{src,app}/**/*' 'packages/**/src/**/*'",
    "format:check": "oxfmt --check 'apps/**/{src,app}/**/*' 'packages/**/src/**/*'",
    "clean": "rm -rf apps/extension/dist",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0"
  },
  "packageManager": "pnpm@10.30.3"
}
